# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client (regenerated by `prisma generate` / `npm run build`)
/src/generated

# scratch: db dumps, exports — contains real student PII
/scratch

# database dumps / backups — NEVER commit (real student PII)
/scratch/db-dumps/
*.sql
*.dump
*.sql.gz

# generated / local-only
graphify-out/
*.bak
*.bak-*

# student photos — real student images (PII), never commit
/storage/
