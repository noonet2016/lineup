// Lineup Attendance System (Next.js Edition) — Prisma schema
// Maps the legacy PHP/MySQL student attendance model into Prisma.
// Prisma 7: WASM client + mariadb driver adapter (no Rust engine / binaryTargets).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Classroom {
  id        Int       @id @default(autoincrement())
  roomName  String    @map("room_name") @db.VarChar(100)
  advisorId Int?      @map("advisor_id")
  advisor   Teacher?  @relation("ClassroomAdvisor", fields: [advisorId], references: [id], onDelete: SetNull)
  students  Student[]
  sessions  AttendanceSession[]
  locations CheckinLocation[]

  @@index([advisorId])
  @@map("classrooms")
}

model Teacher {
  id                 Int                @id @default(autoincrement())
  username           String             @unique @db.VarChar(100)
  passwordHash       String             @map("password_hash") @db.VarChar(255)
  fullName           String             @map("full_name") @db.VarChar(150)
  role               String             @default("advisor") @db.VarChar(50)
  createdAt          DateTime           @default(now()) @map("created_at") @db.DateTime(0)
  lineUserId         String?            @unique @map("line_user_id") @db.VarChar(64)
  lineDisplayName    String?            @map("line_display_name") @db.VarChar(150)
  linePictureUrl     String?            @map("line_picture_url") @db.VarChar(500)
  advisedClassrooms  Classroom[]        @relation("ClassroomAdvisor")
  editedRecords      AttendanceRecord[] @relation("AttendanceRecordEditor")
  holidays           Holiday[]          @relation("HolidayCreator")
  studentExemptions  StudentExemption[] @relation("StudentExemptionCreator")

  @@map("teachers")
}

model Student {
  studentId        String               @id @map("student_id") @db.VarChar(20)
  passwordHash     String               @map("password_hash") @db.VarChar(255)
  fullName         String               @map("full_name") @db.VarChar(150)
  nickname         String?              @db.VarChar(50)
  classroomId      Int                  @map("classroom_id")
  classroom        Classroom            @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  numberInClass    Int?                 @map("number_in_class")
  status           Int                  @default(1) @db.TinyInt
  mustChangePw     Int                  @default(1) @map("must_change_pw") @db.TinyInt
  createdAt        DateTime             @default(now()) @map("created_at") @db.DateTime(0)
  lineUserId       String?              @unique @map("line_user_id") @db.VarChar(64)
  lineDisplayName  String?              @map("line_display_name") @db.VarChar(150)
  linePictureUrl   String?              @map("line_picture_url") @db.VarChar(500)
  attendanceRecords AttendanceRecord[]
  attendanceLogs   AttendanceLog[]
  exemptions       StudentExemption[]

  @@index([classroomId])
  @@map("students")
}

model AttendanceSession {
  id                Int                @id @default(autoincrement())
  sessionDate       DateTime           @map("session_date") @db.Date
  classroomId       Int                @map("classroom_id")
  classroom         Classroom          @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  startTime         DateTime           @default(dbgenerated("'07:45:00'")) @map("start_time") @db.Time(0)
  lateAfter         DateTime           @default(dbgenerated("'08:00:00'")) @map("late_after") @db.Time(0)
  endTime           DateTime           @default(dbgenerated("'08:15:00'")) @map("end_time") @db.Time(0)
  dailyCode         String?            @map("daily_code") @db.VarChar(20)
  createdAt         DateTime           @default(now()) @map("created_at") @db.DateTime(0)
  attendanceRecords AttendanceRecord[]

  @@unique([sessionDate, classroomId])
  @@index([classroomId])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id           Int               @id @default(autoincrement())
  sessionId    Int               @map("session_id")
  session      AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId    String            @map("student_id") @db.VarChar(20)
  student      Student           @relation(fields: [studentId], references: [studentId], onDelete: Cascade)
  // Allowed values: present | late | absent | pending | flagged. Kept as varchar(15) to match the legacy DB shape.
  status       String            @default("absent") @db.VarChar(15)
  checkTime    DateTime?         @map("check_time") @db.DateTime(0)
  latitude     Decimal?          @db.Decimal(10, 7)
  longitude    Decimal?          @db.Decimal(10, 7)
  distanceM    Int?              @map("distance_m")
  ipAddress    String?           @map("ip_address") @db.VarChar(45)
  isSuspicious Int               @default(0) @map("is_suspicious") @db.TinyInt
  editedBy     Int?              @map("edited_by")
  editor       Teacher?          @relation("AttendanceRecordEditor", fields: [editedBy], references: [id], onDelete: SetNull)
  editReason   String?           @map("edit_reason") @db.VarChar(255)

  @@unique([sessionId, studentId])
  @@index([studentId])
  @@index([editedBy])
  @@map("attendance_records")
}

model AttendanceLog {
  id        BigInt    @id @default(autoincrement()) @db.BigInt
  studentId String?   @map("student_id") @db.VarChar(20)
  student   Student?  @relation(fields: [studentId], references: [studentId], onDelete: SetNull)
  eventType String    @map("event_type") @db.VarChar(30)
  detail    String?   @db.Text
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(0)

  @@index([studentId])
  @@map("attendance_logs")
}

model SystemSetting {
  settingKey   String @id @map("setting_key") @db.VarChar(50)
  settingValue String @map("setting_value") @db.VarChar(255)

  @@map("system_settings")
}

model Holiday {
  holidayDate DateTime @id @map("holiday_date") @db.Date
  name        String   @db.VarChar(150)
  createdBy   Int?     @map("created_by")
  creator     Teacher? @relation("HolidayCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(0)

  @@index([createdBy])
  @@map("holidays")
}

model CheckinLocation {
  id          Int       @id @default(autoincrement())
  classroomId Int       @map("classroom_id")
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  name        String    @db.VarChar(100)
  latitude    Decimal   @db.Decimal(10, 7)
  longitude   Decimal   @db.Decimal(10, 7)
  radiusM     Int       @default(400) @map("radius_m")
  isActive    Int       @default(0) @map("is_active") @db.TinyInt
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(0)

  @@index([classroomId])
  @@map("checkin_locations")
}

model StudentExemption {
  id        Int      @id @default(autoincrement())
  studentId String   @map("student_id") @db.VarChar(20)
  student   Student  @relation(fields: [studentId], references: [studentId], onDelete: Cascade)
  reason    String   @db.VarChar(100)
  weekday   Int?     @db.TinyInt
  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  isActive  Int      @default(1) @map("is_active") @db.TinyInt
  createdBy Int?     @map("created_by")
  creator   Teacher? @relation("StudentExemptionCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)

  @@index([studentId])
  @@index([createdBy])
  @@map("student_exemptions")
}
